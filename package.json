{
  "name": "splicr",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "splicr v1.0.1 · Rust Native 多智能体影视解说创作桌面引擎 (Tauri 2 + Rust + React 19)",
  "scripts": {
    "gen:ipc": "node scripts/gen-ipc.mjs",
    "gen:ipc:check": "node scripts/gen-ipc.mjs --check",
    "prebuild": "node scripts/gen-ipc.mjs",
    "predev": "node scripts/gen-ipc.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:pdf": "python3 scripts/generate_manual_pdf.py",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"{src,packages,docs,resources}/**/*.{ts,tsx,css,md,json,html}\" \"*.{json,mjs,ts,md,yaml,yml}\"",
    "format:check": "prettier --check \"{src,packages,docs,resources}/**/*.{ts,tsx,css,md,json,html}\" \"*.{json,mjs,ts,md,yaml,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@splicr/core": "workspace:*",
    "@splicr/ipc": "workspace:*",
    "@splicr/ui": "workspace:*",
    "@splicr/utils": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.95.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "cmdk": "^1.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^1.7.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-devtools": "^1.95.0",
    "@tanstack/router-vite-plugin": "^1.95.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.16.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitepress": "^1.6.3",
    "vitest": "^3.2.0"
  }
}
